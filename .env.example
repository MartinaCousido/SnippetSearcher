# Copiar a .env (que no se commitea) y cambiar la contraseña ANTES del primer
# arranque: la base toma la contraseña solo cuando se crea por primera vez.
SNIPPETS_DB_NAME=snippets
SNIPPETS_DB_USER=snippets
SNIPPETS_DB_PASSWORD=cambiar-en-local
# Secret de la app de Auth0 que lee usuarios (módulo User). Se saca de Pulumi,
# desde SnippetSearcher-infra/auth0:
#   npm run --silent pulumi -- stack output AUTH0_USERS_CLIENT_SECRET --show-secrets
AUTH0_USERS_CLIENT_SECRET=
