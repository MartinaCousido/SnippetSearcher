@startuml componentes-logico
' Vista lógica: módulos del sistema y sus dependencias.
' Las conexiones "memory" indican llamadas en memoria (diseño lógico,
' independiente de cómo se despliegue cada módulo).

title Snippet Searcher - Vista lógica de componentes
allowmixing
skinparam componentStyle uml2
left to right direction

actor Usuario

rectangle "Snippet Searcher" {
  component UI
  component User
  component Snippets
  component Permisos

  interface Language <<interface>> {
    + validate(código, versión): Diagnostic[]
    + lint(código, versión, reglas): Diagnostic[]
    + format(código, versión, reglas): código
    + evaluate(código, versión, inputs): outputs
  }

  component PrintScript
  component "Go" as Go <<futuro>>
  component "Ruby" as Ruby <<futuro>>
}

Usuario --> UI

UI --> User : memory
UI --> Snippets : memory
UI --> Permisos : memory

Snippets --> Permisos : memory
Snippets --> Language : memory

PrintScript ..|> Language
Go ..|> Language
Ruby ..|> Language

@enduml
