@startuml secuencia-actualizar-snippet
' Actualizar un snippet y correr sus tests (US-2, US-4, US-16).
' Falta implementarlo: #16 y #21. Los endpoints son los del README.

title Actualizar snippet y correr sus tests (US-2, US-4, US-16)
autonumber
skinparam sequenceMessageAlign center

actor Usuario
participant UI
participant "Snippet Service" as S
participant "Permission Service" as P
participant "PrintScript Service" as PS
participant "Asset Service\n(Snippet Storage)" as ST
database "Postgres\n(snippets)" as DB
queue "Redis Streams" as Q

Usuario -> UI : edita el código
UI -> S : PUT /snippets/{id} { content }
S -> DB : buscar el snippet
alt no existe
  S --> UI : 404
else existe
  S -> P : GET /permissions/{id}
  P --> S : { canRead, canWrite }
  alt canWrite = false (no es el owner)
    S --> UI : 403
  else es el owner
    S -> PS : POST /validate { code, version }
    alt código inválido
      PS --> S : diagnostics
      S --> UI : 400 { diagnostics }
      UI --> Usuario : muestra la regla, la línea y la columna
    else código válido
      PS --> S : diagnostics: []
      S -> ST : PUT /v1/asset/snippets/{id} (código nuevo)
      S -> DB : compliance = pending
      S --> UI : 200 Snippet
      UI --> Usuario : muestra el snippet
      S -> Q : publicar pedido de lint

      == Tests automáticos (US-16) ==
      loop por cada test del snippet
        S -> PS : ejecutar(código, inputs)
        PS --> S : outputs
        S -> S : comparar con los outputs esperados
        S -> DB : guardar el resultado
      end
    end
  end
end

note over S, DB
  El resultado de los tests no bloquea
  ni revierte la actualización.
  A definir: el endpoint de ejecución del
  servicio de lenguaje (evaluate).
end note
@enduml
